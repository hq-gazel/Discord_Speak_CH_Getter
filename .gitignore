# OBS のシーンコレクション設定ファイルに保存される (本リポジトリ管理外)。
cfg/token.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python

# --- Virtual env (本プロジェクトは venv 不使用だが念のため) ---
.venv/
venv/
env/

# --- Test / Lint cache ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*~

